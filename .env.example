# Add these in Vercel Project Settings > Environment Variables.
EMAILJS_PUBLIC_KEY=replace_with_emailjs_public_key
EMAILJS_SERVICE_ID=replace_with_emailjs_service_id
EMAILJS_TEMPLATE_ID=replace_with_emailjs_template_id
# Optional private EmailJS token.
EMAILJS_PRIVATE_KEY=

# Optional anti-bot verification. If enabled, also set the public site key
# in index.html: <meta name="turnstile-site-key" content="YOUR_SITE_KEY">
TURNSTILE_SECRET_KEY=
# Optional comma-separated additional hosts, without paths.
ALLOWED_ORIGINS=
